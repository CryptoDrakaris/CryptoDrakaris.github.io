---
import { useT, type Lang } from '../i18n/ui';
import { href, SOCIAL } from '../lib/site';
import { owner, etherscanAddressUrl } from '../lib/collection';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { t } = useT(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="brand">
      <a class="logo" href={href(lang)}>DRAKARIS</a>
      <p class="muted">{t('footer.disclaimer')}</p>
      <p class="small">{t('footer.art')}</p>
    </div>
    <ul class="links">
      <li><a href={href(lang, 'collections')}>{t('nav.collections')}</a></li>
      <li><a href={href(lang, 'gallery')}>{t('nav.gallery')}</a></li>
      <li><a href={href(lang, 'blog')}>{t('nav.blog')}</a></li>
      <li><a href={href(lang, 'about')}>{t('nav.about')}</a></li>
      <li><a href={href(lang, 'contact')}>{t('nav.contact')}</a></li>
    </ul>
    <ul class="links">
      <li><a href={SOCIAL.x.url} target="_blank" rel="noopener">X {SOCIAL.x.handle}</a></li>
      <li><a href={SOCIAL.tiktok.url} target="_blank" rel="noopener">TikTok {SOCIAL.tiktok.handle}</a></li>
      <li><a class="mono" href={etherscanAddressUrl(owner.address)} target="_blank" rel="noopener">{owner.ens}</a></li>
    </ul>
  </div>
  <div class="wrap base">
    <span class="eyebrow">© {year} Drakaris</span>
    <span class="eyebrow">gm · wagmi</span>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: var(--bg-2);
    padding-top: 56px;
  }
  .cols {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 32px;
    padding-bottom: 40px;
  }
  .brand {
    display: grid;
    gap: 10px;
    align-content: start;
    max-width: 48ch;
  }
  .logo {
    font-family: 'Unbounded', var(--font-display);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .muted {
    color: var(--muted);
    font-size: 0.92rem;
  }
  .small {
    font-size: 0.85rem;
    color: var(--dim);
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .links a {
    display: inline-block;
    padding-block: 4px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .links a:hover {
    color: var(--accent);
  }
  .base {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 20px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 720px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .brand {
      grid-column: 1 / -1;
    }
  }
</style>
