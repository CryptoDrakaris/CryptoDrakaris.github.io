---
import type { Lang } from '../i18n/ui';
import { href } from '../lib/site';
import { derived, gridSrcset, hasImage, tokenLabel, tokenTitle, tokenPath, media, type Collection, type Token } from '../lib/collection';

interface Props {
  lang: Lang;
  col: Collection;
  token: Token;
  eager?: boolean;
  /** show collection name under the token label */
  showCollection?: boolean;
}
const { lang, col, token, eager = false, showCollection = true } = Astro.props;
const traits = Object.fromEntries(token.attributes.map((a) => [a.trait_type, a.value]));
const m = media(col, token);
const kind = m?.animated ? 'GIF' : m?.kind && !m.grid && m.kind !== 'none' && m.kind !== 'error' ? m.kind.toUpperCase() : null;
---

<a
  class="nft"
  href={href(lang, tokenPath(col, token))}
  data-group={col.group.slug}
  data-collection={col.slug}
  data-traits={JSON.stringify(traits)}
  style={`--card-accent:${col.accent}`}
>
  <div class="img">
    {
      hasImage(col, token) ? (
        <img
          src={derived(col, token, 'grid')}
          srcset={gridSrcset(col, token)}
          sizes="(max-width: 480px) 45vw, (max-width: 900px) 30vw, 230px"
          alt={tokenTitle(col, token)}
          width="600"
          height="600"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="placeholder" role="img" aria-label={tokenTitle(col, token)}>
          <span>{col.name}</span>
        </div>
      )
    }
    {kind && <span class="badge mono">{kind}</span>}
  </div>
  <div class="meta">
    <span class="name">{tokenLabel(col, token)}</span>
    {showCollection && <span class="col">{col.name}</span>}
  </div>
</a>

<style>
  .nft {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--card);
    border: var(--border-w) solid var(--border-color);
    box-shadow: var(--shadow);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .nft:hover {
    border-color: var(--outline, var(--accent));
    box-shadow: var(--shadow-hover);
    transform: translateY(-3px);
  }
  .img {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--bg-2);
  }
  .img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .nft:hover .img img {
    transform: scale(1.04);
  }
  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    padding: 16px;
    text-align: center;
    background: radial-gradient(circle at 30% 20%, color-mix(in srgb, var(--card-accent) 35%, transparent), transparent 70%), var(--bg-2);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text);
  }
  .badge {
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 0.75rem;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.72);
    color: #fff;
  }
  .meta {
    display: grid;
    gap: 2px;
    padding: 12px 14px 14px;
    min-width: 0;
  }
  .name {
    font-weight: 700;
    overflow-wrap: anywhere;
    line-height: 1.3;
  }
  .col {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }
</style>
