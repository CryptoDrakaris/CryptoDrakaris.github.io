---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { LANGS, useT, type Lang } from '../../../i18n/ui';
import { postsFor } from '../../../lib/blog';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const { t } = useT(lang);
const posts = await postsFor(lang);
---

<Base lang={lang} title={t('nav.blog')}>
  <div class="wrap">
    <header class="page-head">
      <span class="eyebrow">{t('blog.eyebrow')}</span>
      <h1>{t('blog.title')}</h1>
      <p class="lead">{t('blog.lead')}</p>
    </header>
    <PostList lang={lang} posts={posts} level={2} />
  </div>
  <div style="height: clamp(64px, 10vw, 120px)"></div>
</Base>
