---
import Base from '../../layouts/Base.astro';
import GroupCard from '../../components/GroupCard.astro';
import NftCard from '../../components/NftCard.astro';
import PostList from '../../components/PostList.astro';
import JoinBand from '../../components/JoinBand.astro';
import Icon from '../../components/Icon.astro';
import { LANGS, useT, type Lang } from '../../i18n/ui';
import { href, SOCIAL } from '../../lib/site';
import { flagships, others, collections, totalTokens, derived, gridSrcset, hasImage, tokenTitle } from '../../lib/collection';
import { flagshipInfo } from '../../content/flagships';
import { postsFor } from '../../lib/blog';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const { t, tn, nf } = useT(lang);

// hero fan: first imaged token of each flagship
const fan = flagships
  .map((g) => {
    for (const col of g.members) for (const token of col.tokens) if (hasImage(col, token)) return { g, col, token };
    return null;
  })
  .filter(Boolean)
  .slice(0, 6) as { g: (typeof flagships)[number]; col: (typeof collections)[number]; token: any }[];

const othersPreview = (others?.members ?? [])
  .flatMap((col) => col.tokens.filter((tok) => hasImage(col, tok)).slice(0, 1).map((token) => ({ col, token })))
  .slice(0, 8);
const posts = (await postsFor(lang)).slice(0, 3);
const themes = flagships.map((g) => flagshipInfo(g.slug)?.theme).filter(Boolean) as any[];
---

<Base lang={lang} image={fan[0] ? derived(fan[0].col, fan[0].token, 'full') : undefined} extraThemes={themes}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{t('home.eyebrow')}</span>
        <h1 class="display-xl">
          <span>{t('home.title.1')}</span>
          <span class="accent">{t('home.title.2')}</span>
        </h1>
        <p class="lead">{t('home.lead')}</p>
        <div class="btn-row">
          <a class="btn btn--accent" href={href(lang, 'collections')}>{t('home.cta.collections')}</a>
          <a class="btn" href={SOCIAL.x.url} target="_blank" rel="noopener"><Icon name="x" /> {t('home.cta.follow')}</a>
        </div>
        <dl class="stats">
          <div><dt>{t('home.stat.tokens')}</dt><dd>{nf.format(totalTokens)}</dd></div>
          <div><dt>{t('home.stat.collections')}</dt><dd>{collections.length}</dd></div>
          <div><dt>{t('home.stat.flagships')}</dt><dd>{flagships.length}</dd></div>
        </dl>
      </div>

      <div class="fan" aria-hidden="true">
        {
          fan.map(({ g, col, token }, i) => (
            <a class={`fan-card f${i}`} href={href(lang, `collections/${g.slug}`)} tabindex="-1" data-theme={flagshipInfo(g.slug)?.theme}>
              <img
                src={derived(col, token, 'grid')}
                srcset={gridSrcset(col, token)}
                sizes="(max-width: 900px) 46vw, 240px"
                alt={tokenTitle(col, token)}
                width="600"
                height="600"
                loading={i < 3 ? 'eager' : 'lazy'}
              />
              <span class="fan-name">{g.name}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div class="stack">
          <span class="eyebrow">{t('home.flagships.eyebrow')}</span>
          <h2>{t('home.flagships.title')}</h2>
          <p class="lead">{t('home.flagships.lead')}</p>
        </div>
        <a class="link-arrow" href={href(lang, 'collections')}>{t('nav.collections')}</a>
      </div>
      <div class="flagships">
        {flagships.map((g, i) => <GroupCard lang={lang} group={g} index={i} />)}
      </div>
    </div>
  </section>

  {
    others && others.members.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head section-head--row">
            <div class="stack">
              <span class="eyebrow">{t('home.others.eyebrow')}</span>
              <h2>{t('home.others.title')}</h2>
              <p class="lead">
                {t('home.others.lead')} {tn('collectionsN', others.members.length)} · {tn('nfts', others.count)}.
              </p>
            </div>
            <a class="link-arrow" href={href(lang, 'collections/others')}>{t('home.others.cta')}</a>
          </div>
          <div class="nft-grid">
            {othersPreview.map(({ col, token }) => <NftCard lang={lang} col={col} token={token} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="wrap">
      <div class="section-head section-head--row">
        <div class="stack">
          <span class="eyebrow">{t('home.blog.eyebrow')}</span>
          <h2>{t('home.blog.title')}</h2>
        </div>
        <a class="link-arrow" href={href(lang, 'blog')}>{t('home.blog.all')}</a>
      </div>
      <PostList lang={lang} posts={posts} />
    </div>
  </section>

  <JoinBand lang={lang} />
</Base>

<style>
  .hero {
    overflow: hidden;
    background: var(--glow), var(--bg);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
    min-height: min(calc(100svh - 66px), 860px);
    padding-block: clamp(48px, 8vw, 96px);
  }
  .hero-copy {
    display: grid;
    gap: 24px;
  }
  h1 span {
    display: block;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 36px;
    margin: 12px 0 0;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .stats div {
    display: grid;
    gap: 2px;
  }
  .stats dt {
    order: 2;
    color: var(--muted);
    font-size: 0.9rem;
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1;
  }

  /* fan of flagship covers */
  .fan {
    position: relative;
    height: clamp(340px, 42vw, 520px);
  }
  .fan-card {
    position: absolute;
    width: 46%;
    aspect-ratio: 1;
    border-radius: var(--radius);
    overflow: hidden;
    border: 3px solid var(--accent);
    box-shadow: 0 20px 50px rgb(0 0 0 / 0.55);
    background: var(--bg);
    transition: transform 0.3s;
  }
  .fan-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .fan-name {
    position: absolute;
    left: 8px;
    bottom: 8px;
    padding: 3px 10px;
    border-radius: var(--btn-radius);
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8rem;
  }
  .f0 { left: 0; top: 6%; transform: rotate(-8deg); z-index: 3; }
  .f1 { left: 27%; top: 0; transform: rotate(3deg); z-index: 4; }
  .f2 { right: 0; top: 8%; transform: rotate(9deg); z-index: 2; }
  .f3 { left: 6%; bottom: 0; transform: rotate(5deg); z-index: 5; }
  .f4 { left: 38%; bottom: 3%; transform: rotate(-4deg); z-index: 6; }
  .f5 { right: 2%; bottom: 6%; transform: rotate(-10deg); z-index: 1; }
  .fan-card:hover {
    transform: rotate(0) scale(1.04);
    z-index: 10;
  }

  .flagships {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr));
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .fan {
      height: clamp(300px, 80vw, 440px);
    }
  }
</style>
