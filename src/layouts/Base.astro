---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_LANG, LANGS, LOCALE, useT, type Lang } from '../i18n/ui';
import { THEME_COLOR, type ThemeKey } from '../lib/themes';
import { asset } from '../lib/site';
import { existsSync } from 'node:fs';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  theme?: ThemeKey;
  /** Section name shown next to the logo, e.g. "Lazy Lions" */
  brand?: string;
  /** Per-collection accent override for pages in the Drakaris shell */
  accent?: string;
}

const { lang, title, description, image: ownImage, theme = 'drakaris', brand, accent } = Astro.props;
// pages without their own picture (gallery, blog, contacts) share the home link preview, 1200×630
const image = ownImage ?? (existsSync('public/og/home.jpg') ? asset('og/home.jpg') : undefined);
const { t } = useT(lang);
const siteName = 'Drakaris';
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} – ${t('meta.tagline')}`;
const desc = description ?? t('meta.description');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rest = Astro.url.pathname.replace(new RegExp(`^${base}/${lang}`), '');
const abs = (p: string) => new URL(p, Astro.site ?? Astro.url).href;
// x-default is the version served to a browser whose language we do not have.
// The root / would be the usual candidate, but it is a noindex redirect stub, and
// hreflang must point at indexable pages – so it is the English twin of this page.
// Open Graph wants en_US, not en-US
const ogLocale = (l: Lang) => LOCALE[l].replace('-', '_');
const style = accent ? `--accent:${accent};--accent-soft:color-mix(in srgb, ${accent} 70%, white);--accent-rgb:${hexRgb(accent)}` : undefined;

function hexRgb(h: string) {
  const n = parseInt(h.replace('#', ''), 16);
  return `${(n >> 16) & 255} ${(n >> 8) & 255} ${n & 255}`;
}
---

<!doctype html>
<html lang={lang} data-theme={theme} style={style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content={THEME_COLOR[theme]} />
    <!-- the owner's "D"; .ico, PNG and home screen icon are rendered from this SVG by scripts/brand-images.mjs -->
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="32x32 48x48" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    {Astro.site && <link rel="canonical" href={abs(Astro.url.pathname)} />}
    {LANGS.map((l) => <link rel="alternate" hreflang={l} href={abs(`${base}/${l}${rest}`)} />)}
    <link rel="alternate" hreflang="x-default" href={abs(`${base}/${DEFAULT_LANG}${rest}`)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {Astro.site && <meta property="og:url" content={abs(Astro.url.pathname)} />}
    <meta property="og:locale" content={ogLocale(lang)} />
    {LANGS.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale(l)} />)}
    {image && <meta property="og:image" content={abs(image)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:creator" content="@cryptodrakaris" />

    <!--
      Переход карточка NFT ↔ страница токена: картинка карточки перетекает в большую.
      У большой картинки имя nft-art постоянное (CSS страницы токена), карточке оно
      ставится только на время перехода – иначе браузер снимал бы все картинки сетки.
      Скрипт в head, потому что pagereveal срабатывает до первой отрисовки. В этот
      момент страница ещё не прокручена к якорю или прежнему месту, поэтому видимость
      карточки проверяется только при уходе со страницы.
    -->
    <script is:inline>
      (() => {
        const pick = (url, visibleOnly) => {
          if (!url) return null;
          const path = new URL(url).pathname;
          for (const img of document.querySelectorAll('a.nft img')) {
            if (new URL(img.closest('a').href).pathname !== path) continue;
            if (!visibleOnly) return img;
            const r = img.getBoundingClientRect();
            if (r.bottom > 0 && r.top < innerHeight) return img;
          }
          return null;
        };
        const mark = (img, vt) => {
          if (!img || !vt) return;
          img.style.viewTransitionName = 'nft-art';
          vt.finished.finally(() => (img.style.viewTransitionName = ''));
        };
        addEventListener('pageswap', (e) => mark(pick(e.activation?.entry.url, true), e.viewTransition));
        addEventListener('pagereveal', (e) => mark(pick(window.navigation?.activation?.from?.url, false), e.viewTransition));
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} brand={brand} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
